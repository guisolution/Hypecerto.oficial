# Copie para .env e preencha. NUNCA versione o .env.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJECT.supabase.co:5432/postgres

# OBRIGATÓRIO em produção (>= 32 caracteres aleatórios):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

ENVIRONMENT=development          # use "production" no servidor
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=25

USE_MOCK_META_API=True           # False para publicar de verdade (e deixe visível na interface)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v18.0
OPENAI_API_KEY=
PUBLIC_BASE_URL=                 # URL pública do backend (usada só para Instagram)
