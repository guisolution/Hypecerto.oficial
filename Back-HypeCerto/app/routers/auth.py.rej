+@router.delete("/delete", response_model=MessageResponse, summary="Excluir a própria conta")
+def delete_account(
+    body: LoginRequest,
+    request: Request,
+    current_user: Usuario = Depends(get_current_user),
+    db: Session = Depends(get_db),
+):
+    """
+    Exclui a conta do usuário AUTENTICADO. Exige JWT válido + confirmação da senha
+    (e o e-mail informado deve ser o do próprio usuário). Falhas são limitadas por rate limit.
+    """
+    email, user_id, senha_hash = current_user.email, current_user.id, current_user.senha_hash
+    check_rate_limit(request, "delete", email, limit=5)
+    senha_ok = body.email.lower() == email.lower() and pwd_context.verify(body.password, senha_hash)
+    if not senha_ok:
+        register_failure(request, "delete", email)
+        raise HTTPException(status_code=401, detail="Confirmação de senha inválida")
 
-    # 3. Deleta o infeliz
     try:
         db.execute(text("DELETE FROM usuarios WHERE id = :id"), {"id": user_id})
         db.commit()
-        return {"message": "Usuário deletado com sucesso no modo bruto!"}
-    except Exception as e:
+    except Exception:
         db.rollback()
-        raise HTTPException(status_code=500, detail=f"Erro no banco: {str(e)}")
+        raise HTTPException(status_code=500, detail="Não foi possível excluir a conta")
+    clear_failures(request, "delete", email)
+    return {"message": "Conta excluída com sucesso", "success": True}
 
 
